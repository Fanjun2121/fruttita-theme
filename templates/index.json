    "sp_duo": {
      "type": "sp-duo",
      "settings": {
        "a_link": "/pages/about",
        "a_placeholder": "",
        "a_eyebrow": "品牌出身",
        "a_eyebrow_en": "Our origin",
        "a_eyebrow_pt": "A nossa origem",
        "a_title": "生在树长的地方。",
        "a_title_en": "Born where the tree grows.",
        "a_title_pt": "Nascida onde a árvore cresce.",
        "a_text": "我们不是从会议室开始的。我们开始于一群多年在野外采集猴面包树果实的人，和一个简单的想法：别加工它。这里是完整的故事，包括我们还在修的部分。",
        "a_text_en": "We didn't start in a boardroom. We started with people who had been collecting this fruit in the wild for years, and one plain idea: don't improve it. Here's the whole story, including the parts we're still fixing.",
