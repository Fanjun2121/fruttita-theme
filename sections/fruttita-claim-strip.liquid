<!--
  Fruttita Custom Section: Claim Strip
  Horizontal row of pill-shaped claim badges with staggered fade-in
-->

<style>
  .fruttita-claim-strip-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.bg_color }};
    padding: 1.3rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    font-family: 'Switzer', sans-serif;
  }

  .fruttita-claim-strip-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  /* --- Pills: hidden by default --- */
  .claim-pill-{{ section.id }} {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 1.1rem;
    border: 1px solid rgba(79, 44, 29, 0.13);
    border-radius: 50px;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: {{ section.settings.text_color }};
    background: rgba(79, 44, 29, 0.03);
    opacity: 0;
    transform: translateY(8px);
  }

  /* --- Dots: hidden by default --- */
  .claim-dot-{{ section.id }} {
    position: relative;
    z-index: 1;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: {{ section.settings.accent_color }};
    flex-shrink: 0;
    opacity: 0;
  }

  /* --- When visible: play animation --- */
  .fruttita-claim-strip-{{ section.id }}.is-visible .claim-pill-{{ section.id }} {
    animation: claimPillIn-{{ section.id }} 0.5s ease forwards;
  }
  .fruttita-claim-strip-{{ section.id }}.is-visible .claim-dot-{{ section.id }} {
    animation: claimDotIn-{{ section.id }} 0.4s ease forwards;
  }

  @keyframes claimPillIn-{{ section.id }} {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes claimDotIn-{{ section.id }} {
    from { opacity: 0; }
    to   { opacity: 0.4; }
  }

  @media (max-width: 768px) {
    .fruttita-claim-strip-{{ section.id }} {
      gap: 0.45rem;
      padding: 1rem 1rem;
    }
    .claim-pill-{{ section.id }} {
      font-size: 1.2rem;
      padding: 0.32rem 0.8rem;
      letter-spacing: 0.03em;
    }
    .claim-dot-{{ section.id }} {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .claim-pill-{{ section.id }},
    .claim-dot-{{ section.id }} {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<div class="fruttita-claim-strip-{{ section.id }}">
  {% for block in section.blocks %}
    {% unless forloop.first %}
      <span class="claim-dot-{{ section.id }}" style="animation-delay:{{ forloop.index0 | times: 0.08 | plus: 0.12 }}s"></span>
    {% endunless %}
    <span class="claim-pill-{{ section.id }}" style="animation-delay:{{ forloop.index0 | times: 0.08 }}s" {{ block.shopify_attributes }}>
      {% render 'i18n-text', default: block.settings.text, en: block.settings.text_en, pt: block.settings.text_pt %}
    </span>
  {% endfor %}
</div>

<script>
  (function() {
    var id = '{{ section.id }}';
    var strip = document.querySelector('.fruttita-claim-strip-' + id);
    if (!strip) return;

    function activate() {
      var obs = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) {
          strip.classList.add('is-visible');
          obs.disconnect();
        }
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      obs.observe(strip);
    }

    /* Wait for full page load so initial layout is settled */
    if (document.readyState === 'complete') {
      activate();
    } else {
      window.addEventListener('load', activate);
    }
  })();
</script>

{% schema %}
{
  "name": "Fruttita Claim Strip",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F1E6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4F2C1D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Dot Accent Color",
      "default": "#C6812B"
    }
  ],
  "blocks": [
    {
      "type": "claim",
      "name": "Claim",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Claim Text",
          "default": "Claim"
        },
        {
          "type": "text",
          "id": "text_en",
          "label": "Claim Text (EN)"
        },
        {
          "type": "text",
          "id": "text_pt",
          "label": "Claim Text (PT)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fruttita Claim Strip"
    }
  ]
}
{% endschema %}
