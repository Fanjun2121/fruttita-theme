<!--
  Fruttita Custom Section: Data Science
  6 metrics with progress bars + expandable easter egg (总多酚)
-->

<style>
  .fruttita-data-science-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 6rem 1.5rem;
    font-family: 'Switzer', sans-serif;
    position: relative;
    overflow: hidden;
  }

  .fruttita-data-science-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .ds-inner-{{ section.id }} {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
  }

  .ds-header-{{ section.id }} {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .ds-subtitle-{{ section.id }} {
    font-family: 'Pacifico', cursive;
    color: #C6812B;
    font-size: var(--fruttita-text-label);
    display: block;
    margin-bottom: 0.5rem;
  }

  .ds-title-{{ section.id }} {
    color: {{ section.settings.text_color }};
    font-size: var(--fruttita-text-h2);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .ds-metric-{{ section.id }} {
    margin-bottom: 2rem;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .ds-metric-{{ section.id }}.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ds-metric-header-{{ section.id }} {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .ds-metric-label-{{ section.id }} {
    font-size: var(--fruttita-text-body);
    font-weight: 600;
  }

  .ds-metric-value-{{ section.id }} {
    font-size: clamp(2.8rem, 2.5vw, 3.6rem);
    font-weight: 700;
    color: #D38235;
    text-align: right;
  }

  .ds-metric-desc-{{ section.id }} {
    color: var(--fruttita-paper-80);
    font-size: var(--fruttita-text-body);
    margin-bottom: 0.6rem;
  }

  .ds-bar-{{ section.id }} {
    width: 100%;
    height: 8px;
    background: rgba(244, 227, 201, 0.15);
    border-radius: 4px;
    overflow: hidden;
  }

  .ds-bar-fill-{{ section.id }} {
    height: 8px;
    border-radius: 4px;
    background: linear-gradient(90deg, #D38235, #78AA00);
    width: 0%;
    transition: width 1.2s ease;
  }

  .ds-metric-{{ section.id }}.is-visible .ds-bar-fill-{{ section.id }} {
    width: var(--fill);
  }

  .ds-easter-egg-{{ section.id }} {
    margin-top: 3rem;
    text-align: center;
  }

  .ds-egg-toggle-{{ section.id }} {
    display: inline-block;
    background: #F4E3C9;
    border: 1px solid #F4E3C9;
    color: #4F2C1D;
    padding: 0.7rem 1.5rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: var(--fruttita-text-small);
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 0.03em;
    font-family: 'Switzer', sans-serif;
  }

  .ds-egg-toggle-{{ section.id }}:hover {
    background: transparent;
    color: #F4E3C9;
  }

  .ds-egg-content-{{ section.id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease, opacity 0.5s ease;
    opacity: 0;
  }

  .ds-egg-content-{{ section.id }}.is-open {
    max-height: 300px;
    opacity: 1;
  }

  .ds-egg-inner-{{ section.id }} {
    padding: 2rem 0 0;
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .ds-egg-title-{{ section.id }} {
    font-size: var(--fruttita-text-h3);
    font-weight: 700;
    margin-bottom: 0.8rem;
    color: #D38235;
  }

  .ds-egg-text-{{ section.id }} {
    color: var(--fruttita-paper-80);
    font-size: var(--fruttita-text-body);
    line-height: 1.8;
  }

  .ds-source-{{ section.id }} {
    margin-top: 3rem;
    text-align: center;
    font-size: var(--fruttita-text-small);
    opacity: 0.75;
    letter-spacing: 0.03em;
  }

  @media (max-width: 768px) {
    .fruttita-data-science-{{ section.id }} {
      padding: 4rem 1rem;
    }

  }

  :lang(en) .ds-title-{{ section.id }},
  :lang(pt) .ds-title-{{ section.id }} {
    font-size: clamp(2.6rem, 2.6vw, 3.4rem);
  }
</style>

<div class="fruttita-data-science-{{ section.id }}">
  <div class="ds-inner-{{ section.id }}">
    <div class="ds-header-{{ section.id }}">
      {% if section.settings.subtitle != blank %}
        <span class="ds-subtitle-{{ section.id }}">{% render 'i18n-text', default: section.settings.subtitle, en: section.settings.subtitle_en, pt: section.settings.subtitle_pt %}</span>
      {% endif %}
      <h2 class="ds-title-{{ section.id }}">{% render 'i18n-text', default: section.settings.title, en: section.settings.title_en, pt: section.settings.title_pt %}</h2>
    </div>

    <div id="dsMetrics-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="ds-metric-{{ section.id }}" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 100 }}ms;">
          <div class="ds-metric-header-{{ section.id }}">
            <span class="ds-metric-label-{{ section.id }}">{% render 'i18n-text', default: block.settings.label, en: block.settings.label_en, pt: block.settings.label_pt %}</span>
            <span class="ds-metric-value-{{ section.id }}">{{ block.settings.value }}</span>
          </div>
          {% if block.settings.description != blank %}
            <div class="ds-metric-desc-{{ section.id }}">{% render 'i18n-text', default: block.settings.description, en: block.settings.description_en, pt: block.settings.description_pt %}</div>
          {% endif %}
          <div class="ds-bar-{{ section.id }}">
            <div class="ds-bar-fill-{{ section.id }}" style="--fill: {{ block.settings.bar_pct }}%"></div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.easter_egg_title != blank %}
      <div class="ds-easter-egg-{{ section.id }}">
        <button class="ds-egg-toggle-{{ section.id }}" id="dsEggToggle-{{ section.id }}" data-open-text="+ {% render 'i18n-text', default: section.settings.toggle_open_text, en: section.settings.toggle_open_text_en, pt: section.settings.toggle_open_text_pt %}" data-close-text="- {% render 'i18n-text', default: section.settings.toggle_close_text, en: section.settings.toggle_close_text_en, pt: section.settings.toggle_close_text_pt %}">
          + {% render 'i18n-text', default: section.settings.toggle_open_text, en: section.settings.toggle_open_text_en, pt: section.settings.toggle_open_text_pt %}
        </button>
        <div class="ds-egg-content-{{ section.id }}" id="dsEggContent-{{ section.id }}">
          <div class="ds-egg-inner-{{ section.id }}">
            <div class="ds-egg-title-{{ section.id }}">{% render 'i18n-text', default: section.settings.easter_egg_title, en: section.settings.easter_egg_title_en, pt: section.settings.easter_egg_title_pt %}</div>
            <p class="ds-egg-text-{{ section.id }}">{% render 'i18n-text', default: section.settings.easter_egg_text, en: section.settings.easter_egg_text_en, pt: section.settings.easter_egg_text_pt %}</p>
          </div>
        </div>
      </div>
    {% endif %}

    {% if section.settings.source_note != blank %}
      <div class="ds-source-{{ section.id }}">{% render 'i18n-text', default: section.settings.source_note, en: section.settings.source_note_en, pt: section.settings.source_note_pt %}</div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* --- Number Counter Animation --- */
    function animateCounter(el) {
      var raw = el.textContent.trim();
      // Parse: prefix (non-digit chars), number, suffix
      var match = raw.match(/^([^\d]*?)([\d.]+)(.*)$/);
      if (!match) return;
      var prefix = match[1];
      var target = parseFloat(match[2]);
      var suffix = match[3];
      var isFloat = match[2].indexOf('.') !== -1;

      if (reducedMotion) { el.textContent = raw; return; }

      var duration = 1200;
      var start = null;
      function step(ts) {
        if (!start) start = ts;
        var progress = Math.min((ts - start) / duration, 1);
        // cubic ease-out
        var eased = 1 - Math.pow(1 - progress, 3);
        var current = eased * target;
        el.textContent = prefix + (isFloat ? current.toFixed(1) : Math.round(current)) + suffix;
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    var metrics = document.querySelectorAll('#dsMetrics-{{ section.id }} .ds-metric-{{ section.id }}');
    if (metrics.length) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            // Trigger counter on the value element
            var valueEl = entry.target.querySelector('.ds-metric-value-{{ section.id }}');
            if (valueEl && !valueEl.dataset.counted) {
              valueEl.dataset.counted = '1';
              animateCounter(valueEl);
            }
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      metrics.forEach(function(m) { observer.observe(m); });
    }

    var toggle = document.getElementById('dsEggToggle-{{ section.id }}');
    var content = document.getElementById('dsEggContent-{{ section.id }}');
    if (toggle && content) {
      toggle.addEventListener('click', function() {
        content.classList.toggle('is-open');
        toggle.textContent = content.classList.contains('is-open') ? toggle.dataset.closeText : toggle.dataset.openText;
      });
    }
  })();
</script>

