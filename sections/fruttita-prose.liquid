<!--
  Fruttita Custom Section: Prose (Reusable centered long-text)
  Supports multiple paragraphs via blocks, optional CTA, optional bg image
-->

<style>
  .fruttita-prose-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 9rem 2rem;
    font-family: 'Switzer', sans-serif;
    position: relative;
    overflow: hidden;
  }

  {% if section.settings.bg_image != blank %}
  .fruttita-prose-{{ section.id }}::after {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
    background-size: cover;
    background-position: center;
    opacity: 0.08;
    pointer-events: none;
    z-index: 0;
  }
  {% endif %}

  .fruttita-prose-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .prose-inner-{{ section.id }} {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .prose-subtitle-{{ section.id }} {
    font-family: 'Pacifico', cursive;
    color: #C6812B;
    font-size: var(--fruttita-text-label);
    display: block;
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .prose-title-{{ section.id }} {
    font-size: var(--fruttita-text-h2);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 2.5rem;
    letter-spacing: 0.02em;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease 0.1s, transform 0.6s ease 0.1s;
  }

  /* Word reveal animation */
  .prose-title-{{ section.id }} .word-reveal {
    display: inline-block;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .fruttita-prose-{{ section.id }}.is-visible .prose-title-{{ section.id }} .word-reveal {
    opacity: 1;
    transform: translateY(0);
  }
  /* When word-reveal is active, disable title-level animation */
  .prose-title-{{ section.id }}.has-word-reveal {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .prose-title-{{ section.id }} .word-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  .prose-paragraph-{{ section.id }} {
    max-width: 62ch;
    margin: 0 auto 1.25em;
    text-align: left;
    font-size: var(--fruttita-text-body);
    line-height: 1.75;
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .fruttita-prose-{{ section.id }} a.prose-btn-{{ section.id }} {
    display: inline-block;
    background: #4F2C1D;
    color: #F4E3C9;
    padding: 1.2rem 2.8rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 2px solid #4F2C1D;
    transition: opacity 0.3s ease, transform 0.3s ease, background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
    font-size: 1.3rem;
    margin-top: 1.5rem;
    opacity: 0;
    transform: translateY(15px);
  }

  .fruttita-prose-{{ section.id }} a.prose-btn-{{ section.id }}:hover {
    background: transparent;
    color: #4F2C1D;
    border-color: #4F2C1D;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
  }

  .fruttita-prose-{{ section.id }}.is-visible .prose-subtitle-{{ section.id }},
  .fruttita-prose-{{ section.id }}.is-visible .prose-title-{{ section.id }},
  .fruttita-prose-{{ section.id }}.is-visible .prose-paragraph-{{ section.id }},
  .fruttita-prose-{{ section.id }}.is-visible .prose-btn-{{ section.id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .fruttita-prose-{{ section.id }}.is-visible .prose-subtitle-{{ section.id }} {
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .fruttita-prose-{{ section.id }} {
      padding: 5.6rem 1.6rem;
    }

  }

  :lang(en) .prose-title-{{ section.id }},
  :lang(pt) .prose-title-{{ section.id }} {
    font-size: var(--fruttita-text-h2);
  }
</style>

<div class="fruttita-prose-{{ section.id }}" id="prose-{{ section.id }}">
  <div class="prose-inner-{{ section.id }}">
    {% if section.settings.subtitle != blank %}
      <span class="prose-subtitle-{{ section.id }}">{% render 'i18n-text', default: section.settings.subtitle, en: section.settings.subtitle_en, pt: section.settings.subtitle_pt %}</span>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="prose-title-{{ section.id }}">{% render 'i18n-text', default: section.settings.title, en: section.settings.title_en, pt: section.settings.title_pt %}</h2>
    {% endif %}

    {% for block in section.blocks %}
      <p class="prose-paragraph-{{ section.id }}" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index | times: 100 | plus: 200 }}ms;">
        {% render 'i18n-text', default: block.settings.text_paragraph, en: block.settings.text_paragraph_en, pt: block.settings.text_paragraph_pt %}
      </p>
    {% endfor %}

    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link | prepend: routes.root_url | replace: '//', '/' }}" class="prose-btn-{{ section.id }}">{% render 'i18n-text', default: section.settings.btn_text, en: section.settings.btn_text_en, pt: section.settings.btn_text_pt %}</a>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    var el = document.getElementById('prose-{{ section.id }}');
    if (!el) return;

    /* --- Word-by-word title reveal --- */
    var titleEl = el.querySelector('.prose-title-{{ section.id }}');
    if (titleEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var text = titleEl.textContent.trim();
      // Detect CJK: if mostly CJK characters, split by character; otherwise by word
      var cjkRatio = (text.match(/[\u4e00-\u9fff\u3400-\u4dbf]/g) || []).length / text.length;
      var parts;
      if (cjkRatio > 0.3) {
        // Split by character for Chinese text
        parts = text.split('');
      } else {
        // Split by word for English/mixed text
        parts = text.split(/\s+/);
      }
      titleEl.innerHTML = '';
      titleEl.classList.add('has-word-reveal');
      parts.forEach(function(part, i) {
        var span = document.createElement('span');
        span.className = 'word-reveal';
        span.textContent = part;
        span.style.transitionDelay = (i * 80) + 'ms';
        titleEl.appendChild(span);
        if (cjkRatio <= 0.3 && i < parts.length - 1) {
          titleEl.appendChild(document.createTextNode(' '));
        }
      });
    }

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    observer.observe(el);
  })();
</script>

{% schema %}
{
  "name": "Fruttita Prose",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (Pacifico)",
      "default": "About Fruttita"
    },
    {
      "type": "text",
      "id": "subtitle_en",
      "label": "Subtitle (EN)"
    },
    {
      "type": "text",
      "id": "subtitle_pt",
      "label": "Subtitle (PT)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ABOUT FRUTTITA"
    },
    {
      "type": "text",
      "id": "title_en",
      "label": "Title (EN)"
    },
    {
      "type": "text",
      "id": "title_pt",
      "label": "Title (PT)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F4E3C9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4F2C1D"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (optional)"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text"
    },
    {
      "type": "text",
      "id": "btn_text_en",
      "label": "Button Text (EN)"
    },
    {
      "type": "text",
      "id": "btn_text_pt",
      "label": "Button Text (PT)"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "text_paragraph",
      "name": "Paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "text_paragraph",
          "label": "Text",
          "default": "Enter paragraph text here."
        },
        {
          "type": "textarea",
          "id": "text_paragraph_en",
          "label": "Text (EN)"
        },
        {
          "type": "textarea",
          "id": "text_paragraph_pt",
          "label": "Text (PT)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fruttita Prose"
    }
  ]
}
{% endschema %}
