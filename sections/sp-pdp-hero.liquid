{%- comment -%} Fruttita Specimen · PDP hero (product page). Uses product media unless overridden. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="sp sp-pdp-hero" style="--sp-pdp-scale:{{ s.image_scale | default: 100 | divided_by: 100.0 }};--sp-photo-bg:{{ s.photo_bg | default: '#E1D6CC' }}">
  <div class="pic">
    {%- if s.image != blank -%}{{ s.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: product.title }}
    {%- elsif product.featured_image != blank -%}{{ product.featured_image | image_url: width: 1600 | image_tag: loading: 'eager', alt: product.title }}
    {%- else -%}<img src="{{ 'fruttita-packshot-shot.png' | asset_url }}" alt="{{ product.title }}" loading="eager" width="1024" height="1024">{%- endif -%}
    {%- if s.placeholder_note != blank -%}<div class="sp-ph">{{ s.placeholder_note }}</div>{%- endif -%}
  </div>
  <div class="txt">
    <div class="sp-lab dim">{%- for block in section.blocks -%}{%- if block.type == 'eyebrow' -%}<span {{ block.shopify_attributes }}>{% render 'i18n-text', default: block.settings.text, en: block.settings.text_en, pt: block.settings.text_pt %}</span>{%- endif -%}{%- endfor -%}</div>
    <h1>{% if s.title_en != blank %}{% render 'i18n-text', default: s.title, en: s.title_en, pt: s.title_pt %}{% else %}{{ product.title }}{% endif %}</h1>
    <p class="sub">{% render 'i18n-text', default: s.sub, en: s.sub_en, pt: s.sub_pt %}</p>
    <div class="facts">{%- for block in section.blocks -%}{%- if block.type == 'fact' -%}<div {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span>{% render 'i18n-text', default: block.settings.label, en: block.settings.label_en, pt: block.settings.label_pt %}</span></div>{%- endif -%}{%- endfor -%}</div>
    <div class="cta">
      {%- if s.btn1_link != blank -%}<a class="sp-btn solid" href="{% render 'sp-url', url: s.btn1_link %}">{% render 'i18n-text', default: s.btn1, en: s.btn1_en, pt: s.btn1_pt %}</a>{%- endif -%}
      {%- if s.btn2_link != blank -%}<a class="sp-btn" href="{% render 'sp-url', url: s.btn2_link %}">{% render 'i18n-text', default: s.btn2, en: s.btn2_en, pt: s.btn2_pt %}</a>{%- endif -%}
    </div>
    <div class="made">{% render 'i18n-text', default: s.made, en: s.made_en, pt: s.made_pt %}</div>
  </div>
</section>
{% schema %}
{
  "name": "SP · Product hero",
  "settings": [
    {"type":"image_picker","id":"image","label":"Override image (else product featured image)"},
    {"type":"color","id":"photo_bg","label":"Photo panel background (match the photo's own background)","default":"#E1D6CC"},
    {"type":"range","id":"image_scale","label":"Image scale %","min":50,"max":140,"step":2,"default":100},
    {"type":"text","id":"placeholder_note","label":"Placeholder note (internal)"},
    {"type":"text","id":"title","label":"标题 zh"},{"type":"text","id":"title_en","label":"Title en (blank = product title)"},{"type":"text","id":"title_pt","label":"pt"},
    {"type":"textarea","id":"sub","label":"副标 zh"},{"type":"textarea","id":"sub_en","label":"Sub en"},{"type":"textarea","id":"sub_pt","label":"pt"},
    {"type":"text","id":"btn1","label":"按钮1 zh"},{"type":"text","id":"btn1_en","label":"Button 1 en"},{"type":"text","id":"btn1_pt","label":"pt"},{"type":"url","id":"btn1_link","label":"Button 1 link"},
    {"type":"text","id":"btn2","label":"按钮2 zh"},{"type":"text","id":"btn2_en","label":"Button 2 en"},{"type":"text","id":"btn2_pt","label":"pt"},{"type":"url","id":"btn2_link","label":"Button 2 link"},
    {"type":"richtext","id":"made","label":"产地行 zh"},{"type":"richtext","id":"made_en","label":"Made line en"},{"type":"richtext","id":"made_pt","label":"pt"}
  ],
  "blocks": [
    {"type":"eyebrow","name":"Eyebrow item","settings":[{"type":"text","id":"text","label":"zh"},{"type":"text","id":"text_en","label":"en"},{"type":"text","id":"text_pt","label":"pt"}]},
    {"type":"fact","name":"Fact","settings":[{"type":"text","id":"value","label":"Value"},{"type":"text","id":"label","label":"zh"},{"type":"text","id":"label_en","label":"en"},{"type":"text","id":"label_pt","label":"pt"}]}
  ],
  "presets": [{"name":"SP · Product hero"}]
}
{% endschema %}
