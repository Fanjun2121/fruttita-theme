        "custom_liquid": "<!--\n  Fruttita Layout Overrides\n  Supplementary !important overrides for Dawn inline styles.\n  Main brand styling is in fruttita-brand.css.\n-->\n\n<style>\n  /* Hide homepage hero on non-index pages (belt-and-suspenders with Liquid conditional) */\n  .fruttita-origin-section { display: none; }\n\n  /* Force brand background on Dawn's inline-styled elements */\n  body, .gradient, .color-background-1 {\n    background: #F9F1E6 !important;\n    background-color: #F9F1E6 !important;\n  }\n\n  /* Heading typography */\n  h1, h2, .h1, .h2 {\n    text-transform: uppercase !important;\n    letter-spacing: -0.01em !important;\n    font-weight: 700 !important;\n  }\n\n  /* Force fruttita sections to inherit text color (override Dawn defaults) */\n  /* Exclude hero & contact sections which control their own colors */\n  [class*=\"fruttita-\"]:not(.fruttita-origin-section):not(.fruttita-contact) h1,\n  [class*=\"fruttita-\"]:not(.fruttita-origin-section):not(.fruttita-contact) h2,\n  [class*=\"fruttita-\"]:not(.fruttita-origin-section):not(.fruttita-contact) h3,\n  [class*=\"fruttita-\"]:not(.fruttita-origin-section):not(.fruttita-contact) p,\n  [class*=\"fruttita-\"]:not(.fruttita-origin-section):not(.fruttita-contact) span,\n  [class*=\"fruttita-\"]:not(.fruttita-origin-section):not(.fruttita-contact) div {\n    color: inherit;\n  }\n\n  [class*=\"vp-card-title-\"] { color: #4F2C1D !important; }\n  [class*=\"vp-card-desc-\"] { color: rgba(79,44,29,0.6) !important; }\n  [class*=\"vp-icon-\"] { color: var(--vp-icon-color, #78AA00) !important; }\n\n  /* Preserve specific accent colors */\n  [class*=\"ds-subtitle-\"],\n  [class*=\"vp-subtitle-\"],\n  [class*=\"wtb-subtitle-\"],\n  [class*=\"nt-subtitle-\"],\n  [class*=\"sc-subtitle-\"],\n  [class*=\"faq-subtitle-\"],\n  [class*=\"cs-subtitle-\"],\n  [class*=\"cm-subtitle-\"],\n  [class*=\"cs-card-name-en-\"],\n  [class*=\"comp-subtitle-\"],\n  [class*=\"hero-subtitle-\"],\n  [class*=\"ps-subtitle-\"],\n  [class*=\"prose-subtitle-\"] {\n    color: #C6812B !important;\n  }\n\n  [class*=\"ds-metric-value-\"],\n  [class*=\"ds-egg-title-\"] {\n    color: #D38235 !important;\n  }\n\n  [class*=\"ds-metric-desc-\"],\n  [class*=\"ds-egg-text-\"] {\n    color: var(--fruttita-paper-80) !important;\n  }\n\n  [class*=\"comp-status-good-\"] {\n    color: #78AA00 !important;\n  }\n\n  [class*=\"nt-value-\"].is-highlight,\n  [class*=\"cm-status-good-\"],\n  [class*=\"cm-col-name-\"].is-winner {\n    color: #78AA00 !important;\n  }\n\n  [class*=\"comp-status-bad-\"] {\n    color: rgba(79,44,29,0.6) !important;\n  }\n\n  [class*=\"cm-status-bad-\"] {\n    color: #EF4444 !important;\n  }\n\n  [class*=\"comp-col-name-\"].is-winner {\n    color: #D38235 !important;\n  }\n\n  [class*=\"comp-conclusion-\"] {\n    color: #4F2C1D !important;\n  }\n\n  /* Preserve element colors against the high-specificity inherit override */\n  #MainContent [class*=\"vp-card-title-\"],\n  #MainContent [class*=\"ps-card-name-cn-\"],\n  #MainContent [class*=\"ps-card-tagline-\"],\n  #MainContent [class*=\"ps-card-specs-\"] {\n    color: #4F2C1D !important;\n  }\n\n  #MainContent [class*=\"vp-card-desc-\"] {\n    color: rgba(79,44,29,0.6) !important;\n  }\n\n  #MainContent [class*=\"vp-icon-\"] {\n    color: var(--vp-icon-color, #78AA00) !important;\n  }\n\n  #MainContent [class*=\"ds-subtitle-\"],\n  #MainContent [class*=\"vp-subtitle-\"],\n  #MainContent [class*=\"wtb-subtitle-\"],\n  #MainContent [class*=\"nt-subtitle-\"],\n  #MainContent [class*=\"sc-subtitle-\"],\n  #MainContent [class*=\"faq-subtitle-\"],\n  #MainContent [class*=\"cs-subtitle-\"],\n  #MainContent [class*=\"cm-subtitle-\"],\n  #MainContent [class*=\"cs-card-name-en-\"],\n  #MainContent [class*=\"comp-subtitle-\"],\n  #MainContent [class*=\"hero-subtitle-\"],\n  #MainContent [class*=\"ps-subtitle-\"],\n  #MainContent [class*=\"ps-card-name-en-\"],\n  #MainContent [class*=\"prose-subtitle-\"] {\n    color: #C6812B !important;\n  }\n\n  #MainContent [class*=\"ds-metric-value-\"],\n  #MainContent [class*=\"ds-egg-title-\"] {\n    color: #D38235 !important;\n  }\n\n  #MainContent [class*=\"ds-metric-desc-\"],\n  #MainContent [class*=\"ds-egg-text-\"] {\n    color: var(--fruttita-paper-80) !important;\n  }\n\n  #MainContent [class*=\"comp-status-good-\"],\n  #MainContent [class*=\"nt-value-\"].is-highlight,\n  #MainContent [class*=\"cm-status-good-\"],\n  #MainContent [class*=\"cm-col-name-\"].is-winner {\n    color: #78AA00 !important;\n  }\n\n  #MainContent [class*=\"comp-status-bad-\"] {\n    color: var(--fruttita-ink-60) !important;\n  }\n\n  #MainContent [class*=\"cm-status-bad-\"] {\n    color: #EF4444 !important;\n  }\n\n  #MainContent [class*=\"comp-col-name-\"].is-winner {\n    color: #D38235 !important;\n  }\n\n  #MainContent [class*=\"comp-conclusion-\"] {\n    color: #4F2C1D !important;\n  }\n\n  #MainContent [class*=\"ps-tag-\"] {\n    color: #4F2C1D !important;\n  }\n\n  #MainContent [class*=\"wtb-logo-placeholder-\"] {\n    color: #F4E3C9 !important;\n  }\n\n  /* ── Collection / Products Page ── */\n\n  /* Banner */\n  .collection-hero {\n    background: #4F2C1D !important;\n    padding: 6.4rem 0 !important;\n  }\n  .collection-hero__title {\n    font-family: 'Switzer', sans-serif !important;\n    color: #F4E3C9 !important;\n    font-size: var(--fruttita-text-h2) !important;\n    font-weight: 700 !important;\n    letter-spacing: 0.02em !important;\n    text-transform: none !important;\n  }\n  .collection-hero__description {\n    color: rgba(244,227,201,0.65) !important;\n  }\n\n  /* Product grid container */\n  .collection {\n    max-width: 960px !important;\n    margin: 0 auto !important;\n  }\n  .product-grid-container {\n    padding-top: 6.4rem;\n  }\n\n  /* Product cards */\n  .product-grid .card-wrapper {\n    border-radius: 12px;\n    overflow: hidden;\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n  }\n  .product-grid .card-wrapper:hover {\n    transform: transla