rm: translateY(25px);\n  animation: heroFadeIn 0.8s ease forwards 0.8s;\n}\n.fruttita-origin-section .origin-text {\n  font-size: var(--fruttita-text-body);\n  line-height: 1.75;\n  margin-bottom: 2.5rem;\n  font-weight: 400;\n  color: var(--fruttita-paper-80) !important;\n  max-width: 480px;\n  margin-left: auto;\n  margin-right: auto;\n  opacity: 0;\n  transform: translateY(20px);\n  animation: heroFadeIn 0.8s ease forwards 1.1s;\n}\n.origin-btn {\n  display: inline-block;\n  background-color: #F4E3C9;\n  color: #4F2C1D;\n  padding: 1.1rem 2.6rem;\n  border-radius: 50px;\n  font-weight: 700;\n  text-decoration: none;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  transition: all 0.3s ease;\n  border: 1px solid #F4E3C9;\n  font-size: 1.2rem;\n  opacity: 0;\n  transform: translateY(20px);\n  animation: heroFadeIn 0.8s ease forwards 1.4s;\n}\n.origin-btn:hover {\n  background-color: transparent;\n  color: #F4E3C9;\n  transform: translateY(-2px);\n}\n.origin-actions {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 1.6rem;\n}\n.fruttita-origin-section .origin-actions a.origin-secondary {\n  color: var(--fruttita-paper-80) !important;\n  font-size: 1.1rem;\n  font-weight: 600;\n  text-decoration: underline;\n  text-decoration-thickness: 1px;\n  text-underline-offset: 0.3em;\n  opacity: 0;\n  transform: translateY(20px);\n  animation: heroFadeIn 0.8s ease forwards 1.55s;\n  transition: color 0.3s ease;\n}\n.fruttita-origin-section .origin-actions a.origin-secondary:hover { color: #F4E3C9 !important; }\n.origin-badge {\n  position: absolute;\n  bottom: 14%;\n  left: 6%;\n  z-index: 3;\n  opacity: 0;\n  animation: heroFadeIn 0.8s ease forwards 1.7s;\n}\n.origin-badge-inner {\n  padding: 0.8rem 1.2rem;\n  border: 1px solid rgba(244,227,201,0.12);\n  border-radius: 10px;\n}\n.origin-badge span {\n  font-weight: 600;\n  font-size: 1.1rem;\n  letter-spacing: 0.08em;\n  color: rgba(244,227,201,0.55) !important;\n}\n.origin-scroll-indicator {\n  position: absolute;\n  bottom: 2rem;\n  left: 50%;\n  transform: translateX(-50%);\n  z-index: 3;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.5rem;\n  color: rgba(244,227,201,0.35) !important;\n  font-size: 1.1rem;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  opacity: 0;\n  animation: heroFadeIn 0.8s ease forwards 2s;\n}\n.origin-scroll-indicator svg { width: 18px; height: 18px; animation: scrollBounce 2s ease-in-out infinite; }\n@keyframes heroLabelFadeIn { to { opacity: 0.9; transform: translateY(0); } }\n@keyframes heroFadeIn { to { opacity: 1; transform: translateY(0); } }\n@keyframes scrollBounce { 0%, 100% { transform: translateY(0); opacity: 1; } 50% { transform: translateY(6px); opacity: 0.3; } }\n@media (max-width: 768px) {\n  .fruttita-origin-section { min-height: min(550px, 150vh); }\n  .origin-title { font-size: var(--fruttita-text-hero); }\n  .origin-subtitle { font-size: var(--fruttita-text-label); }\n  .origin-content { padding: 0 1.5rem; }\n  .origin-tree { display: none; }\n  .origin-badge { bottom: 10%; left: 5%; }\n  .origin-badge span { font-size: 1.1rem; }\n  .origin-actions { flex-direction: column; gap: 1.2rem; }\n  .fruttita-origin-section .origin-actions a.origin-secondary { font-size: var(--fruttita-text-body); }\n  .origin-doodle { display: none; }\n}\n</style>\n\n<div class=\"fruttita-origin-section\">\n  <!-- Hand-drawn doodle accents -->\n  <div class=\"origin-doodle\" style=\"top:10%;left:7%;animation-delay:1.5s\">\n    <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\"><path d=\"M10 3L10 17M3 10L17 10\" stroke=\"rgba(211,130,53,0.2)\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>\n  </div>\n  <div class=\"origin-doodle\" style=\"top:22%;left:14%;animation-delay:1.8s\">\n    <svg width=\"6\" height=\"6\"><circle cx=\"3\" cy=\"3\" r=\"2.5\" fill=\"rgba(244,227,201,0.1)\"/></svg>\n  </div>\n  <div class=\"origin-doodle\" style=\"bottom:28%;left:12%;animation-delay:2.1s\">\n    <svg width=\"18\" height=\"12\" viewBox=\"0 0 18 12\" fill=\"none\"><ellipse cx=\"9\" cy=\"6\" rx=\"7\" ry=\"4\" transform=\"rotate(-25 9 6)\" fill=\"rgba(120,170,0,0.1)\"/></svg>\n  </div>\n  <div class=\"origin-doodle\" style=\"top:16%;right:28%;animation-delay:1.6s\">\n    <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M7 2L7 12M2 7L12 7\" stroke=\"rgba(244,227,201,0.12)\" stroke-width=\"1\" stroke-linecap=\"round\"/></svg>\n  </div>\n  <div class=\"origin-doodle\" style=\"bottom:35%;right:8%;animation-delay:2.3s\">\n    <svg width=\"5\" height=\"5\"><circle cx=\"2.5\" cy=\"2.5\" r=\"2\" fill=\"rgba(211,130,53,0.15)\"/></svg>\n  </div>\n\n  <!-- Babu IP silhouette -->\n  <div class=\"origin-tree\">\n    <img src=\"{{ 'babu-silhouette.svg' | asset_url }}\" alt=\"\" />\n  </div>\n\n  <div class=\"origin-content\">\n    <span class=\"origin-subtitle\">{% if request.locale.iso_code == 'pt-PT' %}Fruttita{% else %}Fruttita{% endif %}</span>\n    <h2 class=\"origin-title\">{% if request.locale.iso_code == 'en' %}Fruit that fought<br>for 3,000 years{% elsif request.locale.iso_code == 'pt-PT' %}Um fruto com<br>3.000 anos de luta{% else %}来自旷野的<br>纯净能量{% endif %}</h2>\n    <p class=\"origin-text\">{% if request.locale.iso_code == 'en' %}African baobab pulp · One ingredient · Nothing else.{% elsif request.locale.iso_code == 'pt-PT' %}Polpa de embondeiro africano · Um ingrediente · Nada mais.{% else %}源自非洲“生命之树”猴面包树{% endif %}</p>\n    <div class=\"origin-actions\">\n      <a href=\"{{ '/pages/baobab' | prepend: routes.root_url | replace: '//', '/' }}\" class=\"origin-btn\">{% if request.locale.iso_code == 'en' %}Meet the Tree{% elsif request.locale.iso_code == 'pt-PT' %}Conhece o Imbondeiro{% else %}了解这棵树{% endif %}</a>\n      <a href=\"/collections/all\" class=\"origin-secondary\">{% if request.locale.iso_code == 'en' %}See products →{% elsif request.locale.iso_code == 'pt-PT' %}Ver produtos →{% else %}看看产品 →{% endif %}</a>\n    </div>\n  </div>\n\n  <div class=\"origin-badge\">\n    <div class=\"origin-badge-inner\"><span>{% if request.locale.iso_code == 'en' %}0 Sodium · High Potassium · Vitamin C of 6 Oranges{% elsif request.locale.iso_code == 'pt-PT' %}0 Sódio · Rico em Potássio · Vitamina C de 6 Laranjas{% else %}0钠 · 高钾 · 高VC{% endif %}</span></div>\n  </div>\n\n  <div class=\"origin-scroll-indicator\">\n    <span>scroll</span>\n    <svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M19 14l-7 7m0 0l-7-7m7 7V3\"></path></svg>\n  </div>\n</div>{% endif %}",
