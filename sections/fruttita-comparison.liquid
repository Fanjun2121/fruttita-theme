<!--
  Fruttita Custom Section: Dual-Column Comparison
  Coconut Water vs Fruttita Shot — 5 metric rows + conclusion
-->

<style>
  .fruttita-comparison-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 6rem 1.5rem;
    font-family: 'Switzer', sans-serif;
    position: relative;
    overflow: hidden;
  }

  .fruttita-comparison-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .comp-inner-{{ section.id }} {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
  }

  .comp-header-{{ section.id }} {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .comp-subtitle-{{ section.id }} {
    font-family: 'Pacifico', cursive;
    color: #C6812B;
    font-size: var(--fruttita-text-label);
    display: block;
    margin-bottom: 0.5rem;
  }

  .comp-title-{{ section.id }} {
    font-size: var(--fruttita-text-h2);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  /* Table header */
  .comp-table-head-{{ section.id }} {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid rgba(79, 44, 29, 0.15);
    margin-bottom: 0.5rem;
  }

  .comp-col-label-{{ section.id }} {
    font-size: var(--fruttita-text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fruttita-ink-60);
    text-align: center;
  }

  .comp-col-label-{{ section.id }}:first-child {
    text-align: left;
  }

  .comp-col-name-{{ section.id }} {
    font-size: var(--fruttita-text-body);
    font-weight: 700;
    text-align: center;
  }

  .comp-col-name-{{ section.id }}.is-winner {
    color: #D38235;
  }

  /* Metric rows */
  .comp-row-{{ section.id }} {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid rgba(79, 44, 29, 0.15);
    align-items: center;
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .comp-row-{{ section.id }}.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Row hover highlight */
  .comp-row-{{ section.id }} {
    border-radius: 0.5rem;
  }
  .comp-row-{{ section.id }}:hover {
    background: rgba(244, 227, 201, 0.06);
    box-shadow: inset 0 0 0 1px rgba(244, 227, 201, 0.08);
  }

  .comp-metric-label-{{ section.id }} {
    font-size: var(--fruttita-text-body);
    font-weight: 600;
  }

  .comp-cell-{{ section.id }} {
    text-align: center;
    font-size: var(--fruttita-text-body);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .comp-status-bad-{{ section.id }} {
    color: var(--fruttita-ink-60);
  }

  .comp-status-good-{{ section.id }} {
    color: #78AA00;
    font-weight: 700;
  }

  .comp-status-icon-{{ section.id }} {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .comp-table-head-{{ section.id }} > :nth-child(3),
  .comp-row-{{ section.id }} > :nth-child(3) {
    align-self: stretch;
    margin-block: -1rem;
    padding: 1rem 0.5rem;
    background: rgba(211, 130, 53, 0.08);
  }

  .comp-row-{{ section.id }} > :nth-child(3) {
    margin-block: -1.2rem;
    padding-block: 1.2rem;
  }

  /* Conclusion */
  .comp-conclusion-{{ section.id }} {
    margin-top: 2.5rem;
    padding: 1.5rem 2rem;
    background: #FFFDF8;
    border: 0;
    border-left: 4px solid #78AA00;
    border-radius: 1rem;
    text-align: center;
    color: #4F2C1D;
    font-size: var(--fruttita-text-body);
    line-height: 1.7;
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .comp-conclusion-{{ section.id }}.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .comp-source-{{ section.id }} {
    margin-top: 2rem;
    text-align: center;
    color: var(--fruttita-ink-60);
    font-size: var(--fruttita-text-small);
    letter-spacing: 0.03em;
  }

  @media (max-width: 768px) {
    .fruttita-comparison-{{ section.id }} {
      padding: 4rem 1rem;
    }

    .comp-table-head-{{ section.id }},
    .comp-row-{{ section.id }} {
      grid-template-columns: 1fr 0.8fr 0.8fr;
      gap: 0.5rem;
    }

    .comp-metric-label-{{ section.id }},
    .comp-cell-{{ section.id }} {
      font-size: var(--fruttita-text-small);
    }

    .comp-col-name-{{ section.id }} {
      font-size: var(--fruttita-text-small);
    }
  }

  :lang(en) .comp-title-{{ section.id }},
  :lang(pt) .comp-title-{{ section.id }} {
    font-size: clamp(2.6rem, 2.6vw, 3.4rem);
  }
</style>

<div class="fruttita-comparison-{{ section.id }}">
  <div class="comp-inner-{{ section.id }}">
    <div class="comp-header-{{ section.id }}">
      {% if section.settings.subtitle != blank %}
        <span class="comp-subtitle-{{ section.id }}">{% render 'i18n-text', default: section.settings.subtitle, en: section.settings.subtitle_en, pt: section.settings.subtitle_pt %}</span>
      {% endif %}
      <h2 class="comp-title-{{ section.id }}">{% render 'i18n-text', default: section.settings.title, en: section.settings.title_en, pt: section.settings.title_pt %}</h2>
    </div>

    <!-- Table header -->
    <div class="comp-table-head-{{ section.id }}">
      <div class="comp-col-label-{{ section.id }}">{% render 'i18n-text', default: section.settings.header_label, en: section.settings.header_label_en, pt: section.settings.header_label_pt %}</div>
      <div class="comp-col-name-{{ section.id }}">{% render 'i18n-text', default: section.settings.comp_name, en: section.settings.comp_name_en, pt: section.settings.comp_name_pt %}</div>
      <div class="comp-col-name-{{ section.id }} is-winner">Fruttita Shot</div>
    </div>

    <!-- Metric rows from blocks -->
    <div id="compRows-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="comp-row-{{ section.id }}" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 100 }}ms;">
          <div class="comp-metric-label-{{ section.id }}">{% render 'i18n-text', default: block.settings.label, en: block.settings.label_en, pt: block.settings.label_pt %}</div>
          <div class="comp-cell-{{ section.id }} comp-status-{{ block.settings.comp_status }}-{{ section.id }}">
            {% if block.settings.comp_status == 'bad' %}
              <svg class="comp-status-icon-{{ section.id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            {% else %}
              <svg class="comp-status-icon-{{ section.id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            {% endif %}
            {% render 'i18n-text', default: block.settings.comp_value, en: block.settings.comp_value_en, pt: block.settings.comp_value_pt %}
          </div>
          <div class="comp-cell-{{ section.id }} comp-status-{{ block.settings.fruttita_status }}-{{ section.id }}">
            {% if block.settings.fruttita_status == 'good' %}
              <svg class="comp-status-icon-{{ section.id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            {% else %}
              <svg class="comp-status-icon-{{ section.id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            {% endif %}
            {% render 'i18n-text', default: block.settings.fruttita_value, en: block.settings.fruttita_value_en, pt: block.settings.fruttita_value_pt %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.conclusion != blank %}
      <div class="comp-conclusion-{{ section.id }}" id="compConclusion-{{ section.id }}">
        {% render 'i18n-text', default: section.settings.conclusion, en: section.settings.conclusion_en, pt: section.settings.conclusion_pt %}
      </div>
    {% endif %}

    {% if section.settings.source_note != blank %}
      <div class="comp-source-{{ section.id }}">{% render 'i18n-text', default: section.settings.source_note, en: section.settings.source_note_en, pt: section.settings.source_note_pt %}</div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    var rows = document.querySelectorAll('#compRows-{{ section.id }} .comp-row-{{ section.id }}');
    var conclusion = document.getElementById('compConclusion-{{ section.id }}');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    rows.forEach(function(row) { observer.observe(row); });
    if (conclusion) observer.observe(conclusion);
  })();
</script>

