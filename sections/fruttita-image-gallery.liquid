<!--
  Fruttita Custom Section: Image Gallery
  2-3 column image grid with optional captions
-->

<style>
  .fruttita-img-gallery-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 9rem 2rem;
    font-family: 'Switzer', sans-serif;
    position: relative;
    overflow: hidden;
  }

  .fruttita-img-gallery-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .ig-inner-{{ section.id }} {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
  }

  .ig-header-{{ section.id }} {
    text-align: center;
    margin-bottom: 4.8rem;
  }

  .ig-subtitle-{{ section.id }} {
    font-family: 'Pacifico', cursive;
    color: #C6812B;
    font-size: var(--fruttita-text-label);
    display: block;
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
    opacity: 0.9;
  }

  .ig-title-{{ section.id }} {
    font-size: var(--fruttita-text-h2);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .ig-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 1.5rem;
  }

  .ig-item-{{ section.id }} {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .ig-item-{{ section.id }}.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .ig-img-wrap-{{ section.id }} {
    border-radius: 1rem;
    overflow: hidden;
    aspect-ratio: {{ section.settings.aspect_ratio }};
    background: rgba({% if section.settings.bg_color == '#F9F1E6' or section.settings.bg_color == '#f9f1e6' %}79, 44, 29{% else %}244, 227, 201{% endif %}, 0.08);
  }

  .ig-img-wrap-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .ig-item-{{ section.id }}:hover .ig-img-wrap-{{ section.id }} img {
    transform: scale(1.04);
  }

  .ig-caption-{{ section.id }} {
    margin-top: 0.8rem;
    font-size: 1.3rem;
    line-height: 1.5;
    opacity: 0.75;
    text-align: center;
  }

  @media (max-width: 768px) {
    .fruttita-img-gallery-{{ section.id }} {
      padding: 5.6rem 1.6rem;
    }

    .ig-grid-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }
  }

  :lang(en) .ig-title-{{ section.id }},
  :lang(pt) .ig-title-{{ section.id }} {
    font-size: var(--fruttita-text-h2);
  }

  #shopify-section-{{ section.id }} .ig-subtitle-{{ section.id }} {
    color: #C6812B !important;
  }
</style>

<div class="fruttita-img-gallery-{{ section.id }}">
  <div class="ig-inner-{{ section.id }}">
    {% if section.settings.subtitle != blank or section.settings.title != blank %}
      <div class="ig-header-{{ section.id }}">
        {% if section.settings.subtitle != blank %}
          <span class="ig-subtitle-{{ section.id }}">{% render 'i18n-text', default: section.settings.subtitle, en: section.settings.subtitle_en, pt: section.settings.subtitle_pt %}</span>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="ig-title-{{ section.id }}">{% render 'i18n-text', default: section.settings.title, en: section.settings.title_en, pt: section.settings.title_pt %}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="ig-grid-{{ section.id }}" id="igGrid-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="ig-item-{{ section.id }}" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 150 }}ms;">
          <div class="ig-img-wrap-{{ section.id }}">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          {% if block.settings.caption != blank %}
            <div class="ig-caption-{{ section.id }}">{% render 'i18n-text', default: block.settings.caption, en: block.settings.caption_en, pt: block.settings.caption_pt %}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function() {
    var items = document.querySelectorAll('#igGrid-{{ section.id }} .ig-item-{{ section.id }}');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    items.forEach(function(item) { observer.observe(item); });
  })();
</script>

{% schema %}
{
  "name": "Fruttita Image Gallery",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (Pacifico)"
    },
    {
      "type": "text",
      "id": "subtitle_en",
      "label": "Subtitle (EN)"
    },
    {
      "type": "text",
      "id": "subtitle_pt",
      "label": "Subtitle (PT)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "title_en",
      "label": "Title (EN)"
    },
    {
      "type": "text",
      "id": "title_pt",
      "label": "Title (PT)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F1E6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4F2C1D"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "default": "3",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" }
      ]
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image Aspect Ratio",
      "default": "4 / 3",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "text",
          "id": "caption_en",
          "label": "Caption (EN)"
        },
        {
          "type": "text",
          "id": "caption_pt",
          "label": "Caption (PT)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fruttita Image Gallery"
    }
  ]
}
{% endschema %}
