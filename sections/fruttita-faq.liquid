<!--
  Fruttita Custom Section: FAQ Accordion
  Expandable Q&A list with smooth animations
-->

<style>
  .fruttita-faq-{{ section.id }} {
    --fruttita-section-secondary: {% if section.settings.bg_color == '#F9F1E6' or section.settings.bg_color == '#f9f1e6' %}var(--fruttita-ink-60){% else %}var(--fruttita-paper-80){% endif %};
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 6rem 1.5rem;
    font-family: 'Switzer', sans-serif;
    position: relative;
    overflow: hidden;
  }

  .fruttita-faq-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .faq-inner-{{ section.id }} {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-header-{{ section.id }} {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .faq-subtitle-{{ section.id }} {
    font-family: 'Pacifico', cursive;
    color: #C6812B;
    font-size: var(--fruttita-text-label);
    display: block;
    margin-bottom: 0.5rem;
  }

  .faq-title-{{ section.id }} {
    font-size: var(--fruttita-text-h2);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .faq-item-{{ section.id }} {
    border-bottom: 1px solid rgba({% if section.settings.bg_color == '#F9F1E6' or section.settings.bg_color == '#f9f1e6' %}79, 44, 29{% else %}244, 227, 201{% endif %}, 0.12);
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .faq-item-{{ section.id }}.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .faq-question-{{ section.id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    cursor: pointer;
    font-size: var(--fruttita-text-body);
    font-weight: 600;
    letter-spacing: 0.01em;
    background: none;
    border: none;
    color: inherit;
    width: 100%;
    text-align: left;
    font-family: 'Switzer', sans-serif;
  }

  .faq-question-{{ section.id }}:hover {
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .faq-icon-{{ section.id }} {
    font-size: 1.5rem;
    font-weight: 300;
    color: #D38235 !important;
    line-height: 1;
    flex-shrink: 0;
    margin-left: 1rem;
    transition: transform 0.3s ease;
  }

  .faq-item-{{ section.id }}.is-open .faq-icon-{{ section.id }} {
    transform: rotate(45deg);
  }

  .faq-answer-{{ section.id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, opacity 0.4s ease;
    opacity: 0;
  }

  .faq-item-{{ section.id }}.is-open .faq-answer-{{ section.id }} {
    max-height: 500px;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .faq-answer-inner-{{ section.id }} {
    padding-bottom: 1.5rem;
    color: var(--fruttita-section-secondary) !important;
    font-size: var(--fruttita-text-body);
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .fruttita-faq-{{ section.id }} {
      padding: 4rem 1rem;
    }

    .faq-question-{{ section.id }} {
      padding: 1.2rem 0;
    }
  }
</style>

<div class="fruttita-faq-{{ section.id }}">
  <div class="faq-inner-{{ section.id }}">
    <div class="faq-header-{{ section.id }}">
      {% if section.settings.subtitle != blank %}
        <span class="faq-subtitle-{{ section.id }}">{% render 'i18n-text', default: section.settings.subtitle, en: section.settings.subtitle_en, pt: section.settings.subtitle_pt %}</span>
      {% endif %}
      <h2 class="faq-title-{{ section.id }}">{% render 'i18n-text', default: section.settings.title, en: section.settings.title_en, pt: section.settings.title_pt %}</h2>
    </div>

    <div id="faqList-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="faq-item-{{ section.id }}" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 80 }}ms;">
          <button class="faq-question-{{ section.id }}" data-faq-toggle="{{ section.id }}">
            <span>{% render 'i18n-text', default: block.settings.question, en: block.settings.question_en, pt: block.settings.question_pt %}</span>
            <span class="faq-icon-{{ section.id }}">+</span>
          </button>
          <div class="faq-answer-{{ section.id }}">
            <div class="faq-answer-inner-{{ section.id }}">{% render 'i18n-text', default: block.settings.answer, en: block.settings.answer_en, pt: block.settings.answer_pt %}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function() {
    var items = document.querySelectorAll('#faqList-{{ section.id }} .faq-item-{{ section.id }}');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    items.forEach(function(item) { observer.observe(item); });

    var toggles = document.querySelectorAll('[data-faq-toggle="{{ section.id }}"]');
    toggles.forEach(function(toggle) {
      toggle.addEventListener('click', function() {
        var item = this.closest('.faq-item-{{ section.id }}');
        var wasOpen = item.classList.contains('is-open');
        // Close all others
        items.forEach(function(i) { i.classList.remove('is-open'); });
        // Toggle current
        if (!wasOpen) item.classList.add('is-open');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Fruttita FAQ",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (Pacifico)",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "subtitle_en",
      "label": "Subtitle (EN)"
    },
    {
      "type": "text",
      "id": "subtitle_pt",
      "label": "Subtitle (PT)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "常见问题"
    },
    {
      "type": "text",
      "id": "title_en",
      "label": "Title (EN)"
    },
    {
      "type": "text",
      "id": "title_pt",
      "label": "Title (PT)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F1E6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4F2C1D"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "问题"
        },
        {
          "type": "text",
          "id": "question_en",
          "label": "Question (EN)"
        },
        {
          "type": "text",
          "id": "question_pt",
          "label": "Question (PT)"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "回答"
        },
        {
          "type": "textarea",
          "id": "answer_en",
          "label": "Answer (EN)"
        },
        {
          "type": "textarea",
          "id": "answer_pt",
          "label": "Answer (PT)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fruttita FAQ"
    }
  ]
}
{% endschema %}
