{%- comment -%} Fruttita Specimen · Process figure (Fig. 2): how each product is made. Icons inline; captions 3-lang. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="sp sp-proc" id="{{ s.anchor | default: section.id }}" style="--n:{{ section.blocks.size }}"><div class="sp-wrap">
  <div class="sp-lab dim">{% render 'i18n-text', default: s.fig_label, en: s.fig_label_en, pt: s.fig_label_pt %}</div>
  <ol class="sp-proclist n{{ section.blocks.size }}">
    {%- for block in section.blocks -%}
    <li {{ block.shopify_attributes }} style="--i:{{ forloop.index0 }}">
      <div class="ic">{%- case block.settings.icon -%}{%- when 'fruit' -%}<svg viewBox="0 0 120 120" aria-hidden="true"><path d="M60 8v18" stroke="#2A1A12" stroke-width="1.5" fill="none"/><path d="M50 8h20" stroke="#2A1A12" stroke-width="1.5"/><ellipse class="mv-fruit" cx="60" cy="70" rx="24" ry="40" fill="#8C4A1E" stroke="#2A1A12" stroke-width="1.5"/><path d="M48 44c-6 14-6 38 0 52" stroke="#F9F1E6" stroke-width="1.2" fill="none" opacity=".55"/></svg>{%- when 'split' -%}<svg viewBox="0 0 120 120" aria-hidden="true"><path d="M22 34c-10 22-8 48 6 62" stroke="#2A1A12" stroke-width="1.5" fill="none"/><path d="M22 34c8-8 18-8 26 0" stroke="#2A1A12" stroke-width="1.5" fill="none"/><g fill="#EFE6D6" stroke="#2A1A12" stroke-width="1.5"><rect x="50" y="42" width="18" height="16" rx="6"/><rect x="66" y="58" width="18" height="16" rx="6"/><rect x="48" y="66" width="16" height="15" rx="6"/><rect x="70" y="36" width="15" height="14" rx="6"/></g><g class="mv-seeds" fill="#2A1A12"><circle cx="98" cy="88" r="3.2"/><circle cx="106" cy="98" r="3.2"/><circle cx="94" cy="102" r="3.2"/></g><path d="M86 84l-8 10" stroke="#2A1A12" stroke-width="1" stroke-dasharray="2 3"/></svg>{%- when 'water' -%}<svg viewBox="0 0 120 120" aria-hidden="true"><path class="mv-drop" d="M60 14c-6 9-10 14-10 20a10 10 0 0 0 20 0c0-6-4-11-10-20z" fill="#F9F1E6" stroke="#2A1A12" stroke-width="1.5"/><path d="M28 54h64l-6 50H34z" fill="#8C4A1E" stroke="#2A1A12" stroke-width="1.5"/><path d="M34 62h52" stroke="#F9F1E6" stroke-width="1.2" opacity=".6"/><g fill="#EFE6D6" stroke="#2A1A12" stroke-width="1"><circle cx="50" cy="80" r="4"/><circle cx="66" cy="90" r="3.5"/><circle cx="62" cy="72" r="3"/></g></svg>{%- when 'pouch' -%}<svg viewBox="0 0 120 120" aria-hidden="true"><g class="mv-heat" fill="none" stroke="#2A1A12" stroke-width="1.5" stroke-linecap="round"><path d="M44 22c4-6 4-10 0-16"/><path d="M60 22c4-6 4-10 0-16"/><path d="M76 22c4-6 4-10 0-16"/></g><rect x="52" y="30" width="16" height="10" rx="3" fill="#F9F1E6" stroke="#2A1A12" stroke-width="1.5"/><path d="M40 44h40l6 60H34z" fill="#EFE6D6" stroke="#2A1A12" stroke-width="1.5"/><path d="M60 58c-8 0-14 6-14 12s6 10 6 22h16c0-12 6-16 6-22s-6-12-14-12z" fill="#8C4A1E"/></svg>{%- when 'bag' -%}<svg viewBox="0 0 120 120" aria-hidden="true"><g class="mv-heat" fill="none" stroke="#2A1A12" stroke-width="1.5" stroke-linecap="round"><path d="M44 22c4-6 4-10 0-16"/><path d="M60 22c4-6 4-10 0-16"/><path d="M76 22c4-6 4-10 0-16"/></g><rect x="54" y="26" width="12" height="8" rx="2" fill="#F9F1E6" stroke="#2A1A12" stroke-width="1.5"/><ellipse cx="60" cy="40" rx="26" ry="8" fill="#F9F1E6" stroke="#2A1A12" stroke-width="1.5"/><path d="M34 40v52c0 4 12 8 26 8s26-4 26-8V40" fill="#EFE6D6" stroke="#2A1A12" stroke-width="1.5"/><path d="M34 58c0 4 12 8 26 8s26-4 26-8M34 76c0 4 12 8 26 8s26-4 26-8" stroke="#2A1A12" stroke-width="1" fill="none" opacity=".7"/></svg>{%- when 'bottle' -%}<svg viewBox="0 0 120 120" aria-hidden="true"><g class="mv-heat" fill="none" stroke="#2A1A12" stroke-width="1.5" stroke-linecap="round"><path d="M44 22c4-6 4-10 0-16"/><path d="M60 22c4-6 4-10 0-16"/><path d="M76 22c4-6 4-10 0-16"/></g><rect x="47" y="28" width="26" height="14" rx="3" fill="#2A1A12"/><path d="M50 42h20v6c8 3 10 8 10 14v40a6 6 0 0 1-6 6H46a6 6 0 0 1-6-6V62c0-6 2-11 10-14z" fill="#8C4A1E" stroke="#2A1A12" stroke-width="1.5"/><path d="M40 92h40v16a6 6 0 0 1-6 6H46a6 6 0 0 1-6-6z" fill="#C9B79C"/><g fill="#EFE6D6"><circle cx="50" cy="100" r="2"/><circle cx="60" cy="104" r="2"/><circle cx="70" cy="99" r="2"/></g></svg>{%- endcase -%}</div>
      <span class="sp-lab">{{ forloop.index | prepend: '0' }} · {% render 'i18n-text', default: block.settings.where, en: block.settings.where_en, pt: block.settings.where_pt %}</span>
      <b>{% render 'i18n-text', default: block.settings.title, en: block.settings.title_en, pt: block.settings.title_pt %}</b>
      {%- unless forloop.last -%}<i class="dot" aria-hidden="true"></i>{%- endunless -%}
    </li>
    {%- endfor -%}
  </ol>
  <button type="button" class="sp-proc-replay">{% render 'i18n-text', default: '再看一遍', en: 'Play again', pt: 'Ver de novo' %}</button>
</div></section>
{% schema %}
{
  "name": "SP · Process figure",
  "settings": [
    {"type":"text","id":"anchor","label":"HTML id (anchor)"},
    {"type":"text","id":"fig_label","label":"图注 zh","default":"图 2 · 从果实到成品"},{"type":"text","id":"fig_label_en","label":"Figure label en","default":"Fig. 2 · How it is made"},{"type":"text","id":"fig_label_pt","label":"pt","default":"Fig. 2 · Como é feito"}
  ],
  "blocks": [{"type":"step","name":"Step","settings":[
    {"type":"select","id":"icon","label":"Icon","default":"fruit","options":[{"value":"fruit","label":"Fruit"},{"value":"split","label":"Shell and seeds out"},{"value":"water","label":"Water added"},{"value":"pouch","label":"Pouch"},{"value":"bag","label":"Aseptic bag in drum"},{"value":"bottle","label":"Glass bottle"}]},
    {"type":"text","id":"where","label":"地点 zh"},{"type":"text","id":"where_en","label":"Where en"},{"type":"text","id":"where_pt","label":"pt"},
    {"type":"text","id":"title","label":"标题 zh"},{"type":"text","id":"title_en","label":"Title en"},{"type":"text","id":"title_pt","label":"pt"}
  ]}],
  "presets": [{"name":"SP · Process figure"}]
}
{% endschema %}
