<!--
  Fruttita Custom Section: Scene Cards
  3-4 emoji scenario cards (grid layout) for product pages
-->

<style>
  .fruttita-scene-cards-{{ section.id }} {
    --fruttita-section-secondary: {% if section.settings.bg_color == '#F9F1E6' or section.settings.bg_color == '#f9f1e6' %}var(--fruttita-ink-60){% else %}var(--fruttita-paper-80){% endif %};
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 12rem 2rem;
    font-family: 'Switzer', sans-serif;
    position: relative;
    overflow: hidden;
  }

  .fruttita-scene-cards-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .sc-inner-{{ section.id }} {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
  }

  .sc-header-{{ section.id }} {
    text-align: center;
    margin-bottom: 5.6rem;
  }

  .sc-subtitle-{{ section.id }} {
    font-family: 'Pacifico', cursive;
    color: #C6812B;
    font-size: var(--fruttita-text-label);
    display: block;
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
    opacity: 0.9;
  }

  .sc-title-{{ section.id }} {
    font-size: var(--fruttita-text-h2);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .sc-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 2.8rem;
  }

  .sc-card-{{ section.id }} {
    background: rgba({% if section.settings.bg_color == '#F9F1E6' or section.settings.bg_color == '#f9f1e6' %}79, 44, 29{% else %}244, 227, 201{% endif %}, 0.08);
    border: 1px solid rgba({% if section.settings.bg_color == '#F9F1E6' or section.settings.bg_color == '#f9f1e6' %}79, 44, 29{% else %}244, 227, 201{% endif %}, 0.12);
    border-radius: 1.2rem;
    padding: 3.6rem 3rem;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .sc-card-{{ section.id }}.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .sc-emoji-{{ section.id }} {
    font-size: 3rem;
    line-height: 1;
    margin-bottom: 1rem;
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .sc-card-{{ section.id }}:hover .sc-emoji-{{ section.id }} {
    animation: fruttita-emoji-bounce-{{ section.id }} 0.5s ease;
  }

  @keyframes fruttita-emoji-bounce-{{ section.id }} {
    0%   { transform: translateY(0); }
    30%  { transform: translateY(-12px) scale(1.15); }
    50%  { transform: translateY(-4px) scale(1.05); }
    70%  { transform: translateY(-8px) scale(1.1); }
    100% { transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-card-{{ section.id }}:hover .sc-emoji-{{ section.id }} {
      animation: none;
    }
  }

  .sc-card-title-{{ section.id }} {
    font-size: var(--fruttita-text-h3);
    font-weight: 700;
    margin-bottom: 0.7rem;
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .sc-card-desc-{{ section.id }} {
    color: var(--fruttita-section-secondary) !important;
    font-size: 1.4rem;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .sc-footer-{{ section.id }} {
    text-align: center;
    margin-top: 2rem;
    color: var(--fruttita-section-secondary) !important;
    font-size: 1.2rem;
    opacity: 0.6;
    font-style: italic;
  }

  @media (max-width: 768px) {
    .fruttita-scene-cards-{{ section.id }} {
      padding: 6.4rem 1.6rem;
    }

    .sc-grid-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .sc-card-{{ section.id }} {
      padding: 1.5rem 1.2rem;
    }
  }

</style>

<div class="fruttita-scene-cards-{{ section.id }}">
  <div class="sc-inner-{{ section.id }}">
    <div class="sc-header-{{ section.id }}">
      {% if section.settings.subtitle != blank %}
        <span class="sc-subtitle-{{ section.id }}">{% render 'i18n-text', default: section.settings.subtitle, en: section.settings.subtitle_en, pt: section.settings.subtitle_pt %}</span>
      {% endif %}
      <h2 class="sc-title-{{ section.id }}">{% render 'i18n-text', default: section.settings.title, en: section.settings.title_en, pt: section.settings.title_pt %}</h2>
    </div>

    <div class="sc-grid-{{ section.id }}" id="scGrid-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="sc-card-{{ section.id }}" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 120 }}ms;">
          {% if block.settings.emoji != blank %}
            <div class="sc-emoji-{{ section.id }}">{{ block.settings.emoji }}</div>
          {% endif %}
          <div class="sc-card-title-{{ section.id }}">{% render 'i18n-text', default: block.settings.title, en: block.settings.title_en, pt: block.settings.title_pt %}</div>
          <div class="sc-card-desc-{{ section.id }}">{% render 'i18n-text', default: block.settings.description, en: block.settings.description_en, pt: block.settings.description_pt %}</div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.footer_text != blank %}
      <div class="sc-footer-{{ section.id }}">{% render 'i18n-text', default: section.settings.footer_text, en: section.settings.footer_text_en, pt: section.settings.footer_text_pt %}</div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    var cards = document.querySelectorAll('#scGrid-{{ section.id }} .sc-card-{{ section.id }}');
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    cards.forEach(function(card) { observer.observe(card); });
  })();
</script>

{% schema %}
{
  "name": "Fruttita Scene Cards",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (Pacifico)",
      "default": "For You"
    },
    {
      "type": "text",
      "id": "subtitle_en",
      "label": "Subtitle (EN)"
    },
    {
      "type": "text",
      "id": "subtitle_pt",
      "label": "Subtitle (PT)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "什么时候需要它？"
    },
    {
      "type": "text",
      "id": "title_en",
      "label": "Title (EN)"
    },
    {
      "type": "text",
      "id": "title_pt",
      "label": "Title (PT)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F1E6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4F2C1D"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "default": "3",
      "options": [
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ]
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text (optional)"
    },
    {
      "type": "text",
      "id": "footer_text_en",
      "label": "Footer Text (EN)"
    },
    {
      "type": "text",
      "id": "footer_text_pt",
      "label": "Footer Text (PT)"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Scene Card",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji",
          "default": "🌙"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "场景标题"
        },
        {
          "type": "text",
          "id": "title_en",
          "label": "Card Title (EN)"
        },
        {
          "type": "text",
          "id": "title_pt",
          "label": "Card Title (PT)"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "场景描述文字"
        },
        {
          "type": "textarea",
          "id": "description_en",
          "label": "Card Description (EN)"
        },
        {
          "type": "textarea",
          "id": "description_pt",
          "label": "Card Description (PT)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fruttita Scene Cards"
    }
  ]
}
{% endschema %}
